rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // هل صاحب الطلب أدمن؟ يتحقق من وجود وثيقة بنفس الـ uid في مجموعة admins.
    // ملاحظة أمنية: لا يمكن لأي مستخدم عادي إنشاء نفسه كأدمن (allow write: if false
    // بالأسفل) — إضافة أدمن جديد تتم فقط يدوياً من Firebase Console أو عبر Admin SDK.
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // مجموعة الأدمن: كل مستخدم يقدر يتحقق فقط من كونه هو نفسه أدمن (لعرض/إخفاء
    // لوحة التحكم بالواجهة)، ولا أحد يقدر يكتب فيها من التطبيق إطلاقاً.
    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ملف كل مستخدم: يقرأه الجميع (لأجل الترتيب)، لكن لا يعدّله إلا صاحبه —
    // باستثناء حقل الحظر (banned) اللي ما يقدر غير الأدمن يعدّله.
    match /users/{userId} {
      allow read: if true;
      allow create: if isSignedIn() && request.auth.uid == userId
                     && (!("banned" in request.resource.data) || request.resource.data.banned == false);
      allow update: if isAdmin()
                     || (isSignedIn() && request.auth.uid == userId
                         && request.resource.data.banned == resource.data.get("banned", false));
      allow delete: if false;
    }

    // كل الغرسات: يقرأها الجميع، وينشئها فقط صاحب الحساب باسمه (وبشرط أنه غير
    // محظور)، ولا تُعدَّل/تُحذف بعد الإرسال إلا من طرف الأدمن (مراجعة/رفض مخالفات).
    // (moderationStatus يُحدَّد من فحص الصورة في التطبيق نفسه؛ لاحقًا يُفضَّل التحقق منه
    // أيضًا من طرف خادم/Cloud Function عوض الاكتفاء بفحص جهة العميل فقط)
    match /plantings/{id} {
      allow read: if true;
      allow create: if isSignedIn()
                     && request.resource.data.userId == request.auth.uid
                     && request.resource.data.points is int
                     && request.resource.data.points <= 50
                     && request.resource.data.moderationStatus in ["approved", "pending_review"]
                     && !(exists(/databases/$(database)/documents/users/$(request.auth.uid))
                          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("banned", false) == true);
      allow update, delete: if isAdmin();
    }

    // جلسات البث المباشر: يقرأها الجميع، ويتحكم فيها صاحبها فقط أو الأدمن (لإيقاف بث مخالف)
    match /liveSessions/{userId} {
      allow read: if true;
      allow write: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }
  }
}
